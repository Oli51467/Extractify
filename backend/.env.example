PORT=13434
REQUEST_TIMEOUT_MS=300000
TRUST_PROXY=false
USE_HELMET=true

# 允许多个来源时用逗号分隔，生产环境请改成真实域名
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# 上传限制
MAX_FILE_SIZE_MB=50

# 目录配置（支持相对 backend/ 的路径或绝对路径）
UPLOAD_ROOT=uploads
JOBS_ROOT=uploads/jobs
TEMP_ROOT=temp
DATA_ROOT=data
DB_FILE=data/extractify.sqlite

# 并发与清理策略
JOB_QUEUE_CONCURRENCY=2
JOB_QUEUE_MAX_SIZE=100
JOB_RETENTION_HOURS=72
JOB_CLEANUP_INTERVAL_HOURS=6

# .doc 转换工具（留空则自动探测 soffice）
SOFFICE_PATH=
# OCR 工具（留空则自动探测 tesseract）
TESSERACT_PATH=

# 图片去重（按相似度自动去重，默认保留最高分辨率原图）
IMAGE_DEDUPE_ENABLED=true
IMAGE_DEDUPE_HAMMING_THRESHOLD=6
IMAGE_DEDUPE_ASPECT_TOLERANCE=0.03
AUTO_OCR_ENABLED=true
AUTO_NAMING_ENABLED=true
SHARE_LINK_ENABLED=true
SHARE_LINK_TTL_HOURS=168

# 轻量会话隔离（无登录）
SESSION_COOKIE_NAME=extractify_sid
SESSION_COOKIE_MAX_AGE_HOURS=168
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_SECURE=false
